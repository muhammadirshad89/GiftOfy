# Copy to .env (never commit .env). Placeholders only.
# Supabase > Project Settings > API. Use the anon/public key. NEVER put a service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Public site URL used in share links and canonical tags
VITE_SITE_URL=https://giftofy.vercel.app

# --- Optional: Google AdSense unit (leave unset/false until your site is approved and you have created a unit) ---
# When both are set, ONE labelled ad slot appears after the main content of public guide/message pages only
# (never in the create wizard, the wish reveal, replies or admin). Nothing else loads; the AdSense loader is already in index.html.
VITE_ADSENSE_ENABLED=false
VITE_ADSENSE_SLOT_CONTENT=
